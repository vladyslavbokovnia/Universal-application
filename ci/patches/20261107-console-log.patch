+        // ------------------------------------------------------------ журнал консоли вкладки (для «Копировать ошибки консоли»)
+
+        /** Строка в журнал консоли вкладки; зовётся и из потока запросов, поэтому под замком. Хранятся последние 300 строк. */
+        private void consoleLog(Tab t, String kind, String text) {
+            if (t == null || text == null) return;
+            String line = new java.text.SimpleDateFormat("HH:mm:ss", Locale.ROOT).format(new java.util.Date()) + " " + kind + ": "
+                    + (text.length() > 600 ? text.substring(0, 600) + "…" : text);
+            synchronized (t.consoleLog) {
+                t.consoleLog.add(line);
+                while (t.consoleLog.size() > 300) t.consoleLog.remove(0);
+            }
+        }
+
+        private int consoleCount(Tab t) {
+            synchronized (t.consoleLog) { return t.consoleLog.size(); }
+        }
+
+        /** Журнал вкладки одним текстом с шапкой (адрес, профиль, UA, версия Android); при переполнении остаётся конец. */
+        private String consoleDump(Tab t) {
+            List<String> copy;
+            synchronized (t.consoleLog) { copy = new ArrayList<String>(t.consoleLog); }
+            StringBuilder sb = new StringBuilder();
+            sb.append("Страница: ").append(t.url == null ? "" : t.url).append('\n');
+            sb.append("Профиль: ").append(profileName(t.profile)).append('\n');
+            sb.append("UA: ").append(userAgentFor(t)).append('\n');
+            sb.append("Android ").append(Build.VERSION.RELEASE).append(" (API ").append(Build.VERSION.SDK_INT).append(")\n");
+            sb.append("Строк в журнале: ").append(copy.size()).append("\n\n");
+            StringBuilder body = new StringBuilder();
+            for (String s : copy) body.append(s).append('\n');
+            String b = body.toString();
+            if (b.length() > 90000) b = "…\n" + b.substring(b.length() - 90000);
+            return sb.append(b).toString();
+        }
+
+        private void copyConsole(Tab t) {
+            if (t == null) return;
+            int n = consoleCount(t);
+            if (n == 0) { toast("Журнал консоли этой вкладки пуст: ошибок не было"); return; }
+            try {
+                ((ClipboardManager) act.getSystemService(Context.CLIPBOARD_SERVICE))
+                        .setPrimaryClip(ClipData.newPlainText("console", consoleDump(t)));
+                toast("Скопировано строк журнала консоли: " + n);
+            } catch (Throwable e) {
+                toast("Не удалось скопировать: " + e);
+            }
+        }
+
+        private void clearConsole(Tab t) {
+            if (t == null) return;
+            synchronized (t.consoleLog) { t.consoleLog.clear(); }
+            toast("Журнал консоли очищен");
+        }
