+        if (wifiCb == null || appCtx == null) return;
+        try {
+            ((ConnectivityManager) appCtx.getSystemService(Context.CONNECTIVITY_SERVICE)).unregisterNetworkCallback(wifiCb);
+        } catch (Throwable t) { }
+        wifiCb = null;
