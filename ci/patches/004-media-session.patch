+    /**
+     * Подмена navigator.mediaSession (в этом WebView его нет) поверх нативной MediaSession: кнопки наушников, шторка и часы
+     * приходят странице как обычные обработчики setActionHandler. Маркер @@MS@@ заменяется именем моста вкладки.
+     * Работает только в самой странице (не во фреймах). Повторная вставка безвредна (защита __ubMs).
+     */
+    private static final String MS_POLYFILL =
+            "(function(){var B=window['@@MS@@'];if(!B||window.__ubMs||window.top!==window||navigator.mediaSession)return;\n" +
+            "function def(o,k,v){try{Object.defineProperty(o,k,{value:v,configurable:true,writable:true});}catch(e){}}\n" +
+            "def(window,'__ubMs',1);\n" +
+            "var handlers={},meta=null,state='none',pos=null,timer=0;\n" +
+            "function MediaMetadata(i){i=i||{};this.title=i.title==null?'':String(i.title);this.artist=i.artist==null?'':String(i.artist);\n" +
+            "this.album=i.album==null?'':String(i.album);this.artwork=i.artwork||[];}\n" +
+            "function flush(){timer=0;try{B.update(JSON.stringify({s:state,t:meta?meta.title:'',a:meta?meta.artist:'',al:meta?meta.album:'',\n" +
+            "h:Object.keys(handlers),p:pos?{d:+pos.duration||0,r:pos.playbackRate==null?1:+pos.playbackRate,x:+pos.position||0}:null}));}catch(e){}}\n" +
+            "function push(){if(!timer)timer=setTimeout(flush,40);}\n" +
+            "var MS={setActionHandler:function(a,f){a=String(a);if(typeof f==='function')handlers[a]=f;else delete handlers[a];push();},\n" +
+            "setPositionState:function(p){pos=p||null;push();},setCameraActive:function(){},setMicrophoneActive:function(){}};\n" +
+            "Object.defineProperty(MS,'metadata',{get:function(){return meta;},set:function(m){meta=m||null;push();},enumerable:true});\n" +
+            "Object.defineProperty(MS,'playbackState',{get:function(){return state;},set:function(s){state=String(s);push();},enumerable:true});\n" +
+            "def(window,'__ubMsAct',function(a,v){var f=handlers[a];if(!f)return;try{f({action:a,seekTime:v,seekOffset:v});}catch(e){console.error(e);}});\n" +
+            "def(window,'MediaMetadata',MediaMetadata);def(navigator,'mediaSession',MS);\n" +
+            "})();\n";
