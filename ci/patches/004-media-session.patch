+        // ------------------------------------------------------------ mediaSession для страниц (поверх нативной MediaSession)
+
+        private android.media.session.MediaSession msSession;
+        private Tab msTab;                  // вкладка, которой сейчас принадлежит сессия; только главный поток
+
+        private final class MsBridge {
+            private final Tab t;
+            MsBridge(Tab t) { this.t = t; }
+
+            @JavascriptInterface public void update(final String json) {
+                if (json == null || json.length() > 20000) return;
+                h.post(new Runnable() {
+                    @Override public void run() { if (!closed) msUpdate(t, json); }
+                });
+            }
+        }
+
+        private long msAction(String name) {
+            if (name.equals("play")) return android.media.session.PlaybackState.ACTION_PLAY;
+            if (name.equals("pause")) return android.media.session.PlaybackState.ACTION_PAUSE;
+            if (name.equals("stop")) return android.media.session.PlaybackState.ACTION_STOP;
+            if (name.equals("nexttrack")) return android.media.session.PlaybackState.ACTION_SKIP_TO_NEXT;
+            if (name.equals("previoustrack")) return android.media.session.PlaybackState.ACTION_SKIP_TO_PREVIOUS;
+            if (name.equals("seekbackward")) return android.media.session.PlaybackState.ACTION_REWIND;
+            if (name.equals("seekforward")) return android.media.session.PlaybackState.ACTION_FAST_FORWARD;
+            if (name.equals("seekto")) return android.media.session.PlaybackState.ACTION_SEEK_TO;
+            return 0;
+        }
+
+        /** Состояние страницы (метаданные, кнопки, позиция) переносится в системную MediaSession. */
+        private void msUpdate(Tab t, String json) {
+            try {
+                JSONObject o = new JSONObject(json);
+                JSONArray hs = o.optJSONArray("h");
+                String state = o.optString("s", "none");
+                boolean playing = state.equals("playing");
+                if ((hs == null || hs.length() == 0) && !playing && !state.equals("paused")) {
+                    if (msTab == t) msRelease();      // страница сняла все обработчики: сессия не нужна
+                    return;
+                }
+                if (msSession == null) {
+                    msSession = new android.media.session.MediaSession(act.getApplicationContext(), "BrowserPage");
+                    msSession.setCallback(new android.media.session.MediaSession.Callback() {
+                        @Override public void onPlay() { msAct("play", 0); }
+                        @Override public void onPause() { msAct("pause", 0); }
+                        @Override public void onStop() { msAct("stop", 0); }
+                        @Override public void onSkipToNext() { msAct("nexttrack", 0); }
+                        @Override public void onSkipToPrevious() { msAct("previoustrack", 0); }
+                        @Override public void onRewind() { msAct("seekbackward", 10); }
+                        @Override public void onFastForward() { msAct("seekforward", 10); }
+                        @Override public void onSeekTo(long pos) { msAct("seekto", pos / 1000.0); }
+                    }, h);
+                }
+                msTab = t;
+                long actions = 0;
+                if (hs != null) for (int i = 0; i < hs.length(); i++) actions |= msAction(hs.optString(i));
+                long pos = android.media.session.PlaybackState.PLAYBACK_POSITION_UNKNOWN, dur = 0;
+                float rate = playing ? 1f : 0f;
+                JSONObject p = o.optJSONObject("p");
+                if (p != null) {
+                    dur = (long) (p.optDouble("d", 0) * 1000);
+                    pos = (long) (p.optDouble("x", 0) * 1000);
+                    if (playing) rate = (float) p.optDouble("r", 1);
+                }
+                msSession.setPlaybackState(new android.media.session.PlaybackState.Builder()
+                        .setActions(actions)
+                        .setState(playing ? android.media.session.PlaybackState.STATE_PLAYING
+                                : android.media.session.PlaybackState.STATE_PAUSED, pos, rate)
+                        .build());
+                android.media.MediaMetadata.Builder mb = new android.media.MediaMetadata.Builder()
+                        .putString(android.media.MediaMetadata.METADATA_KEY_TITLE, o.optString("t", ""))
+                        .putString(android.media.MediaMetadata.METADATA_KEY_ARTIST, o.optString("a", ""))
+                        .putString(android.media.MediaMetadata.METADATA_KEY_ALBUM, o.optString("al", ""));
+                if (dur > 0) mb.putLong(android.media.MediaMetadata.METADATA_KEY_DURATION, dur);
+                msSession.setMetadata(mb.build());
+                msSession.setActive(true);
+            } catch (Throwable ignored) { }
+        }
+
+        /** Команда с кнопки наушников или шторки уходит обработчику, который зарегистрировала страница. */
+        private void msAct(String action, double v) {
+            Tab t = msTab;
+            if (closed || t == null || t.wv == null) return;
+            t.wv.evaluateJavascript("try{window.__ubMsAct('" + action + "'," + v + ")}catch(e){}", null);
+        }
+
+        private void msRelease() {
+            msTab = null;
+            android.media.session.MediaSession s = msSession;
+            msSession = null;
+            if (s == null) return;
+            try { s.setActive(false); s.release(); } catch (Throwable ignored) { }
+        }
+
