+    private static final int[] SEEK_STEPS = {5, 10, 15, 20, 30, 45, 60, 90, 120};
+
+    /** Шаг перемотки в секундах (настройка seek_step, по умолчанию 10). */
+    private int seekStepSec() {
+        SharedPreferences p = prefs();
+        int v = p == null ? 10 : p.getInt("seek_step", 10);
+        return Math.max(1, Math.min(600, v));
+    }
+
+    private int seekStepMs() {
+        return seekStepSec() * 1000;
+    }
+
+    private static String ruSeconds(int n) {
+        int m100 = n % 100;
+        int m10 = n % 10;
+        if (m100 >= 11 && m100 <= 14) return "секунд";
+        if (m10 == 1) return "секунда";
+        if (m10 >= 2 && m10 <= 4) return "секунды";
+        return "секунд";
+    }
+
+    /** Кнопка геймпада: шаг перемотки на ступень больше (dir = 1) или меньше (dir = -1); ступени 5-120 с, значение озвучивается. */
+    private void changeSeekStep(int dir) {
+        int cur = seekStepSec();
+        int next = cur;
+        if (dir > 0) {
+            for (int i = 0; i < SEEK_STEPS.length; i++) {
+                if (SEEK_STEPS[i] > cur) { next = SEEK_STEPS[i]; break; }
+            }
+        } else {
+            for (int i = SEEK_STEPS.length - 1; i >= 0; i--) {
+                if (SEEK_STEPS[i] < cur) { next = SEEK_STEPS[i]; break; }
+            }
+        }
+        SharedPreferences p = prefs();
+        if (p != null) p.edit().putInt("seek_step", next).apply();
+        speak(next + " " + ruSeconds(next));
+    }
