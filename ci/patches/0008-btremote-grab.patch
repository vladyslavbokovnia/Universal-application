+                if (!names.contains(nm) || !path.matches("/dev/input/event\\d+") || padPaths.contains(path)) continue;
+                synchronized (lock) { if (excluded.contains(path)) continue; }
+                res.add(path);
+            }
+        }
+        Collections.sort(res);
+        return res;
+    }
