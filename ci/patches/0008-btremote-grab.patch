+    private void grabLoop(int gen) {
+        while (gen(gen)) {
+            scanNames();
+            List<String> paths = grabPaths();
+            if (paths.isEmpty()) { grabState = "жду пульт: нет устройств с назначенными кнопками"; sleepMs(4000); continue; }
