+    /** Взвести удаление доигранного трека. Песни из «Поделиться» и избранное не трогаем. */
+    private void armAutoDelete(Track t) {
+        if (pendDelId != Long.MIN_VALUE) {               // предыдущий ещё ждал (трек короче окна): его срок вышел
