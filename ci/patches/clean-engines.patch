+            f.delete();
+            new File(f.getPath() + ".tmp").delete();
+            rmTree(new File(c.getCodeCacheDir(), "dep-" + name));
+            rmTree(dataDir(c, name));
+        }
+    }
+
+    /** То же в фоне, с уведомлением 🗑🧩. */
