+        private int iconBg(Bitmap b) {
+            try {
+                int w = b.getWidth(), hh = b.getHeight(), n = 0;
+                float sum = 0;
+                for (int y = 0; y < 16; y++) {
+                    for (int x = 0; x < 16; x++) {
+                        int px = b.getPixel((int) ((x + 0.5f) * w / 16), (int) ((y + 0.5f) * hh / 16));
+                        if (Color.alpha(px) < 128) continue;
+                        sum += (0.299f * Color.red(px) + 0.587f * Color.green(px) + 0.114f * Color.blue(px)) / 255f;
+                        n++;
+                    }
+                }
+                if (n >= 8 && sum / n > 0.8f) return 0x99000000;
+            } catch (Throwable ignored) { }
+            return 0x00000000;
+        }
