+        // ------------------------------------------------------------ тёмная тема сайтов (затемнение WebView)
+
+        private Integer darkApiCache;
+
+        /**
+         * Какое затемнение есть у WebView устройства: 1 — WebViewFeature.ALGORITHMIC_DARKENING (androidx.webkit 1.7+),
+         * 2 — старый FORCE_DARK, 0 — нет ничего. androidx.webkit лежит в хосте, поэтому всё через рефлексию.
+         * Затемнение работает на сайтах без собственной тёмной темы; у сайтов с prefers-color-scheme остаётся их тема.
+         */
+        private int darkApi() {
+            if (darkApiCache != null) return darkApiCache.intValue();
+            int r = 0;
+            ClassLoader cl = Browser.class.getClassLoader();
+            try {
+                Class<?> f = Class.forName("androidx.webkit.WebViewFeature", true, cl);
+                Method sup = f.getMethod("isFeatureSupported", String.class);
+                if (Boolean.TRUE.equals(sup.invoke(null, String.valueOf(f.getField("ALGORITHMIC_DARKENING").get(null))))) r = 1;
+                else if (Boolean.TRUE.equals(sup.invoke(null, String.valueOf(f.getField("FORCE_DARK").get(null))))) r = 2;
+            } catch (Throwable ignored) {
+                if (r == 0) {
+                    try {
+                        Class<?> f = Class.forName("androidx.webkit.WebViewFeature", true, cl);
+                        Method sup = f.getMethod("isFeatureSupported", String.class);
+                        if (Boolean.TRUE.equals(sup.invoke(null, String.valueOf(f.getField("FORCE_DARK").get(null))))) r = 2;
+                    } catch (Throwable ignored2) { }
+                }
+            }
+            darkApiCache = Integer.valueOf(r);
+            return r;
+        }
+
+        private boolean applyDarkening(WebView w, boolean on) {
+            int api = darkApi();
+            if (w == null || api == 0) return false;
+            try {
+                Class<?> c = Class.forName("androidx.webkit.WebSettingsCompat", true, Browser.class.getClassLoader());
+                WebSettings st = w.getSettings();
+                if (api == 1) {
+                    c.getMethod("setAlgorithmicDarkeningAllowed", WebSettings.class, boolean.class).invoke(null, st, Boolean.valueOf(on));
+                } else {
+                    c.getMethod("setForceDark", WebSettings.class, int.class).invoke(null, st, Integer.valueOf(c.getField(on ? "FORCE_DARK_ON" : "FORCE_DARK_OFF").getInt(null)));
+                    if (on) {
+                        try {
+                            c.getMethod("setForceDarkStrategy", WebSettings.class, int.class).invoke(null, st,
+                                    Integer.valueOf(c.getField("DARK_STRATEGY_PREFER_WEB_THEME_OVER_USER_AGENT_DARKENING").getInt(null)));
+                        } catch (Throwable ignored) { }
+                    }
+                }
+                return true;
+            } catch (Throwable t) {
+                return false;
+            }
+        }
+
+        /** Ключ сайта для списка тёмных: хост без www. */
+        private String darkKey(String url) {
+            String hst = hostOf(url == null ? "" : url).toLowerCase(Locale.ROOT);
+            return hst.startsWith("www.") ? hst.substring(4) : hst;
+        }
+
+        private boolean darkHostOn(String url) {
+            String k = darkKey(url);
+            if (k.length() == 0) return false;
+            for (String x : sp.getString("dark_hosts", "").split("\n")) if (x.equals(k)) return true;
+            return false;
+        }
+
+        private void darkRemember(String url, boolean on) {
+            String k = darkKey(url);
+            if (k.length() == 0) return;
+            StringBuilder sb = new StringBuilder();
+            for (String x : sp.getString("dark_hosts", "").split("\n")) if (x.length() > 0 && !x.equals(k)) sb.append(x).append('\n');
+            if (on) sb.append(k).append('\n');
+            sp.edit().putString("dark_hosts", sb.toString()).apply();
+        }
+
+        /** Перед загрузкой страницы включает или выключает затемнение для её сайта. */
+        private void refreshDark(Tab t, String url) {
+            if (t.wv == null || t.blocked || darkApi() == 0) return;
+            applyDarkening(t.wv, darkHostOn(url));
+        }
