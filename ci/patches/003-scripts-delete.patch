+        /** Удаляет файл скрипта из папки скриптов (кнопка ✕ на экране «Скрипты»). */
+        static synchronized String remove(UserScript s) {
+            if (s == null || s.file == null) return "Скрипт не найден";
+            String path = s.file.getAbsolutePath();
+            boolean ok = s.file.delete();
+            cache.remove(path);
+            return ok ? "Скрипт удалён: " + s.name : "Не удалось удалить файл " + path + " (нужен доступ ко всем файлам)";
+        }
