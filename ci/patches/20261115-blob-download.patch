+        private boolean xferBegin(final Xfer x, long size, String mime, String jsName) {
+            synchronized (x) {
+                if (x.done) return false;
+                String nm = nameFromCd(x.cd);
+                if (nm == null && jsName != null && jsName.trim().length() > 0) nm = jsName;
+                String mt = mime != null && mime.length() > 0 ? mime : (x.mime != null && x.mime.length() > 0 ? x.mime : "application/octet-stream");
+                if (nm == null) nm = URLUtil.guessFileName(x.url, x.cd, mt);
+                nm = cleanName(nm, mt);
+                try {
+                    openOut(x, nm, mt);
+                } catch (Throwable e) {
+                    xferFail(x, e.getMessage() == null ? "не удалось создать файл" : e.getMessage());
+                    return false;
+                }
+                x.name = nm;
+                x.mime = mt;
+                x.size = size;
+                x.begun = true;
+                x.last = SystemClock.uptimeMillis();
+                final Dl d = x.dl;
+                final String fn = nm;
+                final long total = size;
+                h.post(new Runnable() {
+                    @Override public void run() {
+                        d.name = fn;
+                        d.total = total > 0 ? total : -1;
+                        d.mime = x.mime;
+                        updateDl(d);
+                    }
+                });
+                return true;
+            }
+        }
+
+        private boolean xferWrite(final Xfer x, byte[] b) {
+            synchronized (x) {
+                if (x.done || x.os == null) return false;
+                try {
+                    x.os.write(b);
+                } catch (Throwable e) {
+                    xferFail(x, e.getMessage() == null ? "ошибка записи" : e.getMessage());
+                    return false;
+                }
+                x.got += b.length;
+                long now = SystemClock.uptimeMillis();
+                x.last = now;
+                if (now - x.lastUi > 120) {
+                    x.lastUi = now;
+                    final long g = x.got;
+                    final Dl d = x.dl;
+                    h.post(new Runnable() { @Override public void run() { d.done = g; updateDl(d); } });
+                }
+                return true;
+            }
+        }
+
+        private void xferClose(Xfer x, boolean deletePartial) {
+            try { if (x.os != null) x.os.close(); } catch (Throwable ignored) { }
+            x.os = null;
+            if (deletePartial) {
+                try {
+                    if (x.uri != null) act.getContentResolver().delete(x.uri, null, null);
+                    else if (x.file != null) x.file.delete();
+                } catch (Throwable ignored) { }
+            }
+        }
+
+        private void xferEnd(final Xfer x) {
+            synchronized (x) {
+                if (x.done) return;
+                if (x.size > 0 && x.got != x.size) { xferFail(x, "получено " + x.got + " из " + x.size + " байт"); return; }
+                xferClose(x, false);
+                try {
+                    if (x.uri != null) {
+                        ContentValues v = new ContentValues();
+                        v.put(MediaStore.MediaColumns.IS_PENDING, 0);
+                        act.getContentResolver().update(x.uri, v, null, null);
+                    }
+                } catch (Throwable ignored) { }
+                x.done = true;
+                xfers.remove(x.token);
+                final Dl d = x.dl;
+                final long g = x.got;
+                final Uri u = x.uri;
+                h.post(new Runnable() {
+                    @Override public void run() {
+                        d.done = g;
+                        d.total = g;
+                        d.uri = u;
+                        finishDl(d, true, null);
+                    }
+                });
+            }
+        }
+
+        private void xferFail(final Xfer x, final String msg) {
+            synchronized (x) {
+                if (x.done) return;
+                x.done = true;
+                xfers.remove(x.token);
+                xferClose(x, true);
+            }
+            final Dl d = x.dl;
+            h.post(new Runnable() { @Override public void run() { finishDl(d, false, msg == null ? "ошибка" : msg); } });
+        }
