+            if (d.total > 0) {
+                int p = (int) Math.min(100, d.done * 100 / d.total);
+                d.pct.setText(p + "%");
+                d.pb.set(d.done / (float) d.total, C_ACCENT);
+                d.info.setText(fmtSize(d.done) + " из " + fmtSize(d.total) + d.hint);
+            } else {
+                d.tick++;
+                d.pct.setText(d.done > 0 ? fmtSize(d.done) : "");
+                d.pb.set(((d.tick * 7) % 90 + 5) / 100f, C_ACCENT);       // размер неизвестен: полоса ходит туда-сюда
+                d.info.setText((d.done > 0 ? "Размер неизвестен" : "Подготовка…") + d.hint);
+            }
+            d.row.setContentDescription("Загрузка " + d.name + (d.total > 0 ? ", " + (int) Math.min(100, d.done * 100 / d.total) + " процентов" : ""));
+        }
