+        private String nameFromCd(String cd) {
+            if (cd == null) return null;
+            Matcher m = Pattern.compile("filename\\*?\\s*=\\s*(?:[Uu][Tt][Ff]-8'[^']*')?\"?([^\";]+)\"?").matcher(cd);
+            if (!m.find()) return null;
+            String n = Uri.decode(m.group(1)).trim();
+            return n.length() == 0 ? null : n;
+        }
+
+        private String cleanName(String n, String mime) {
+            n = n == null ? "" : n.replaceAll("[\\\\/:*?\"<>|\\p{Cntrl}]", "_").trim();
+            while (n.startsWith(".")) n = n.substring(1);
+            if (n.length() > 120) {
+                int dot = n.lastIndexOf('.');
+                String ext = dot > 0 && n.length() - dot <= 12 ? n.substring(dot) : "";
+                n = n.substring(0, 120 - ext.length()) + ext;
+            }
+            if (n.length() == 0) n = "file";
+            if (n.indexOf('.') < 0 && mime != null) {
+                String ext = MimeTypeMap.getSingleton().getExtensionFromMimeType(mime.split(";")[0].trim());
+                if (ext != null) n = n + "." + ext;
+            }
+            return n;
+        }
