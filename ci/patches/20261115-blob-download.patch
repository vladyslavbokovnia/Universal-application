+                @Override public void run() {
+                    if (x.done || closed) return;
+                    long idle = SystemClock.uptimeMillis() - x.last;
+                    if (idle > (x.begun ? 30000 : 20000)) { xferFail(x, "страница не передала файл"); return; }
+                    h.postDelayed(this, 5000);
