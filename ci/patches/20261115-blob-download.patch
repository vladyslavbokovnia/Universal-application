+        private final Runnable dlTick = new Runnable() {
+            @Override public void run() {
+                boolean any = false;
+                for (Dl d : new ArrayList<Dl>(dls)) {
+                    if (d.dmId >= 0 && !d.finished) { any = true; pollDm(d); }
+                }
+                if (any && !closed && !detached) h.postDelayed(this, 400); else dlTickOn = false;
+            }
+        };
