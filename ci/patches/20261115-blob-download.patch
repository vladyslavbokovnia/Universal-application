+        private String dmReason(int r, Dl d) {
+            switch (r) {
+                case DownloadManager.ERROR_INSUFFICIENT_SPACE: return "нет места на устройстве";
+                case DownloadManager.ERROR_DEVICE_NOT_FOUND: return "нет накопителя";
+                case DownloadManager.ERROR_FILE_ALREADY_EXISTS: return "файл уже существует";
+                case DownloadManager.ERROR_FILE_ERROR: return "ошибка записи файла";
+                case DownloadManager.ERROR_HTTP_DATA_ERROR: return "обрыв передачи";
+                case DownloadManager.ERROR_TOO_MANY_REDIRECTS: return "слишком много перенаправлений";
+                case DownloadManager.ERROR_UNHANDLED_HTTP_CODE: return "неожиданный ответ сервера";
+                case DownloadManager.ERROR_CANNOT_RESUME: return "нельзя продолжить";
+                default: break;
+            }
+            if (r >= 400 && r < 600) return "сервер ответил " + r + (d.hint.length() > 0 ? " (нужен вход: у профиля нет cookies)" : "");
+            return "код " + r;
+        }
+
+        private void pollDm(Dl d) {
+            android.database.Cursor c = null;
+            try {
+                DownloadManager dm = (DownloadManager) act.getSystemService(Context.DOWNLOAD_SERVICE);
+                c = dm.query(new DownloadManager.Query().setFilterById(d.dmId));
+                if (c == null || !c.moveToFirst()) {        // запись удалена из «Загрузок»
+                    d.cancelled = true;
+                    finishDl(d, false, null);
+                    return;
+                }
+                int st = c.getInt(c.getColumnIndexOrThrow(DownloadManager.COLUMN_STATUS));
+                long got = c.getLong(c.getColumnIndexOrThrow(DownloadManager.COLUMN_BYTES_DOWNLOADED_SO_FAR));
+                long tot = c.getLong(c.getColumnIndexOrThrow(DownloadManager.COLUMN_TOTAL_SIZE_BYTES));
+                int reason = c.getInt(c.getColumnIndexOrThrow(DownloadManager.COLUMN_REASON));
+                d.done = got;
+                d.total = tot > 0 ? tot : -1;
+                if (st == DownloadManager.STATUS_SUCCESSFUL) {
+                    try { d.uri = dm.getUriForDownloadedFile(d.dmId); } catch (Throwable ignored) { }
+                    String mt = c.getString(c.getColumnIndexOrThrow(DownloadManager.COLUMN_MEDIA_TYPE));
+                    if (mt != null && mt.length() > 0) d.mime = mt;
+                    finishDl(d, true, null);
+                } else if (st == DownloadManager.STATUS_FAILED) {
+                    finishDl(d, false, dmReason(reason, d));
+                } else {
+                    updateDl(d);
+                    if (st == DownloadManager.STATUS_PAUSED) {
+                        d.info.setText("Пауза: " + (reason == DownloadManager.PAUSED_WAITING_FOR_NETWORK ? "ждём сеть"
+                                : reason == DownloadManager.PAUSED_QUEUED_FOR_WIFI ? "ждём Wi-Fi" : "ждём повтора") + d.hint);
+                    } else if (st == DownloadManager.STATUS_PENDING) {
+                        d.info.setText("В очереди" + d.hint);
+                    }
+                }
+            } catch (Throwable ignored) {
+            } finally {
+                if (c != null) try { c.close(); } catch (Throwable ignored) { }
+            }
+        }
