+            xfers.put(x.token, x);
+            String js = "(function(){var B=window[" + JSONObject.quote(t.dlName) + "],T=" + JSONObject.quote(x.token) + ",U=" + JSONObject.quote(url) + ";"
+                    + "function F(m){try{B.fail(T,String(m));}catch(e){}}"
+                    + "try{var nm=window.__udName||'';window.__udName='';"
+                    + "var src=window.__udBlob?window.__udBlob(U):null;"
+                    + "(src?Promise.resolve(src):fetch(U).then(function(r){if(!r.ok)throw new Error('HTTP '+r.status);return r.blob();}))"
+                    + ".then(function(b){"
+                    + "if(!B.begin(T,b.size,b.type||'',nm))return;"
+                    + "var CH=786432,pos=0;"
+                    + "function next(){if(pos>=b.size){B.end(T);return;}"
+                    + "var rd=new FileReader();"
+                    + "rd.onload=function(){var s=String(rd.result),i=s.indexOf(',');if(!B.chunk(T,s.substring(i+1)))return;pos+=CH;setTimeout(next,0);};"
