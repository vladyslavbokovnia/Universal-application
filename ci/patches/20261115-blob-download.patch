+            d.title.setText((ok ? "✔ " : "✕ ") + d.name);
+            d.pct.setText(ok ? "100%" : "");
+            d.pct.setTextColor(col);
+            d.pb.set(ok ? 1f : (d.total > 0 ? d.done / (float) d.total : 0f), col);
+            d.info.setText(ok ? "Сохранено в «Загрузки» · нажмите, чтобы открыть" : "Не удалось: " + msg + " · нажмите, чтобы убрать");
+            d.row.setBackground(round(0xF01E1E1E, 14, col, 2));
+            String say = ok ? "Файл сохранён: " + d.name : "Загрузка не удалась: " + d.name + ", " + msg;
+            d.row.setContentDescription(say);
+            try { d.row.performHapticFeedback(HapticFeedbackConstants.LONG_PRESS); } catch (Throwable ignored) { }
+            try { d.row.announceForAccessibility(say); } catch (Throwable ignored) { }
+            toast(say);
+            if (ok) {
+                h.postDelayed(new Runnable() {
+                    @Override public void run() { if (dls.contains(d)) removeDl(d); }
