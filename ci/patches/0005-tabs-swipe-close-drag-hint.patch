+                    float rad = dp(12);
+                    p.setStyle(android.graphics.Paint.Style.FILL);
+                    p.setColor(0x884FC3F7);
+                    c.drawRoundRect(area, rad, rad, p);
+                    p.setStyle(android.graphics.Paint.Style.STROKE);
+                    p.setStrokeWidth(dp(5));
+                    p.setColor(C_ACCENT);
+                    c.drawRoundRect(area, rad, rad, p);
+                    p.setStyle(android.graphics.Paint.Style.FILL);
