+        /**
+         * Места значков кольца вокруг кнопки: смещения от центра кнопки в пикселях. Если круг помещается на экране, значки стоят
+         * по кругу, первый сверху. У края экрана круг не сдвигается, а перестраивается в дугу по самому длинному свободному
+         * участку; если на дуге тесно, остальные значки уходят на следующее кольцо побольше.
+         */
+        private float[][] ringSpots(int n, float cx, float cy, float r, float half, float w, float h) {
+            final int step = 4;
+            final int cnt = 360 / step;
+            final float margin = half + dp(6);
+            final float gap = 2 * half + dp(8);
+            float[][] out = new float[n][2];
+            int placed = 0;
+            for (int k = 0; placed < n && k < 5; k++) {
+                float rr = r + k * (2 * half + dp(10));
+                boolean[] ok = new boolean[cnt];
+                boolean all = true;
+                for (int s = 0; s < cnt; s++) {
+                    double a = Math.toRadians(s * step);
+                    float x = cx + (float) (rr * Math.cos(a));
+                    float y = cy + (float) (rr * Math.sin(a));
+                    ok[s] = x >= margin && x <= w - margin && y >= margin && y <= h - margin;
+                    if (!ok[s]) all = false;
+                }
+                int left = n - placed;
+                double[] ang = null;
+                if (all) {
+                    int m = Math.min(left, (int) Math.floor(2 * Math.PI * rr / gap));
+                    if (m > 0) {
+                        ang = new double[m];
+                        double start = -Math.PI / 2 + (k % 2 == 1 ? Math.PI / m : 0);
+                        for (int i = 0; i < m; i++) ang[i] = start + 2 * Math.PI * i / m;
+                    }
+                } else {
+                    int bestStart = -1, bestLen = 0;
+                    for (int s0 = 0; s0 < cnt; s0++) {
+                        if (!ok[s0] || ok[(s0 - 1 + cnt) % cnt]) continue;      // начало свободного участка (может переходить через 0)
+                        int len = 0;
+                        while (len < cnt && ok[(s0 + len) % cnt]) len++;
+                        if (len > bestLen) { bestLen = len; bestStart = s0; }
+                    }
+                    if (bestStart >= 0) {
+                        double span = (bestLen - 1) * step;                     // градусов
+                        double arcLen = rr * Math.toRadians(span);
+                        int m = Math.min(left, (int) Math.floor(arcLen / gap) + 1);
+                        if (m > 0) {
+                            double mid = bestStart * step + span / 2;
+                            double stepA = m > 1 ? Math.min(span / (m - 1), Math.toDegrees(gap * 1.4 / rr)) : 0;
+                            double first = mid - stepA * (m - 1) / 2;
+                            ang = new double[m];
+                            for (int i = 0; i < m; i++) ang[i] = Math.toRadians(first + i * stepA);
+                        }
+                    }
+                }
+                if (ang == null) continue;
+                for (double a : ang) {
+                    out[placed][0] = (float) (rr * Math.cos(a));
+                    out[placed][1] = (float) (rr * Math.sin(a));
+                    placed++;
+                }
+            }
+            for (int i = placed; i < n; i++) {          // совсем крошечное окно: остаток кладём на первое кольцо подряд
+                double a = -Math.PI / 2 + 2 * Math.PI * i / n;
+                out[i][0] = (float) (r * Math.cos(a));
+                out[i][1] = (float) (r * Math.sin(a));
+            }
+            return out;
+        }
