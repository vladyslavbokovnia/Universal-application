+package im.manus.universalhost;
+
+import android.app.AlertDialog;
+import android.content.ClipData;
+import android.content.ClipboardManager;
+import android.content.Context;
+import android.content.Intent;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.graphics.Color;
+import android.graphics.drawable.GradientDrawable;
+import android.net.Uri;
+import android.speech.tts.TextToSpeech;
+import android.text.TextUtils;
+import android.view.GestureDetector;
+import android.view.Gravity;
+import android.view.MotionEvent;
+import android.view.View;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Список ссылок модуля «YouTube аудио» в стиле плеера: плитки 16:9 с превью, без текста.
+ * Тап по плитке качает ссылку, двойной тап показывает название поверх картинки и озвучивает его.
+ * Угловые значки: 🔗 открыть в браузере приложения, 🗑 убрать. Метка слева сверху: ⏳ ждёт, ⬇ качается,
+ * 🚫 нет русской дорожки (остаётся в списке), ⚠️ ошибка. Сверху ряд кнопок: сеть, из буфера, качать всё, очистить.
+ */
+public final class YtQueueView extends LinearLayout {
+
+    private static final Pattern ID = Pattern.compile("(?:v=|youtu\\.be/|shorts/|embed/)([A-Za-z0-9_-]{11})");
+    private static ExecutorService pool;
+
+    public static View create(Context ctx) {
+        return new YtQueueView(ctx);
+    }
+
+    private final YtAudioQueue q;
+    private final Runnable onChange = new Runnable() {
+        @Override public void run() { rebuild(); }
+    };
+    private TextToSpeech tts;
+    private boolean ttsReady;
+
+    private YtQueueView(Context ctx) {
+        super(ctx);
+        q = YtAudioQueue.get(ctx);
+        setOrientation(VERTICAL);
+        setPadding(dp(10), dp(6), dp(10), dp(6));
+        rebuild();
+    }
+
+    @Override protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        q.addListener(onChange);
+        rebuild();
+    }
+
+    @Override protected void onDetachedFromWindow() {
+        q.removeListener(onChange);
+        try { if (tts != null) tts.shutdown(); } catch (Throwable t) { }
+        tts = null;
+        ttsReady = false;
+        super.onDetachedFromWindow();
+    }
+
+    private int dp(int v) {
+        return (int) (v * getResources().getDisplayMetrics().density + 0.5f);
+    }
+
+    // ---------------------------------------------------------- озвучка
+
+    private void speak(String text) {
+        final String s = text == null ? "" : text.trim();
+        if (s.length() == 0) return;
+        if (tts == null) {
+            tts = new TextToSpeech(getContext().getApplicationContext(), new TextToSpeech.OnInitListener() {
+                @Override public void onInit(int status) {
+                    if (status != TextToSpeech.SUCCESS || tts == null) return;
+                    tts.setLanguage(new Locale("ru", "RU"));
+                    ttsReady = true;
+                    tts.speak(s, TextToSpeech.QUEUE_FLUSH, null, "ytq");
+                }
+            });
+        } else if (ttsReady) {
+            tts.speak(s, TextToSpeech.QUEUE_FLUSH, null, "ytq");
+        }
+    }
+
+    // ---------------------------------------------------------- сборка
+
+    private void rebuild() {
+        removeAllViews();
+        addView(toolbar());
+        List<YtAudioQueue.Item> items = q.snapshot();
+        if (items.isEmpty()) {
+            TextView empty = new TextView(getContext());
+            empty.setText("📭");
+            empty.setTextSize(40);
+            empty.setGravity(Gravity.CENTER);
+            empty.setPadding(0, dp(24), 0, dp(24));
+            empty.setOnClickListener(new OnClickListener() {
+                @Override public void onClick(View v) { speak("Список пуст. Ссылки появятся здесь, когда ты нажмёшь наушники в скрипте YouTube."); }
+            });
+            addView(empty);
+            return;
+        }
+        List<View> tiles = new ArrayList<View>();
+        for (YtAudioQueue.Item it : items) tiles.add(tile(it));
+        for (int i = 0; i < tiles.size(); i += 2) {
+            LinearLayout row = new LinearLayout(getContext());
+            row.setOrientation(HORIZONTAL);
+            for (int k = 0; k < 2; k++) {
+                View v = i + k < tiles.size() ? tiles.get(i + k) : new View(getContext());
+                LayoutParams lp = new LayoutParams(0, LayoutParams.WRAP_CONTENT, 1f);
+                lp.setMargins(dp(3), dp(3), dp(3), dp(3));
+                row.addView(v, lp);
+            }
+            addView(row);
+        }
+    }
+
+    private View logoButton(String glyph, final Runnable act) {
+        TextView tv = new TextView(getContext());
+        tv.setText(glyph);
+        tv.setTextSize(24);
+        tv.setGravity(Gravity.CENTER);
+        tv.setTextColor(Color.WHITE);
+        GradientDrawable bg = new GradientDrawable();
+        bg.setColor(Color.rgb(34, 34, 34));
+        bg.setStroke(dp(1), Color.GRAY);
+        bg.setCornerRadius(dp(12));
+        tv.setBackground(bg);
+        tv.setOnClickListener(new OnClickListener() {
+            @Override public void onClick(View v) { act.run(); }
+        });
+        LayoutParams lp = new LayoutParams(dp(52), dp(52));
+        lp.setMargins(0, 0, dp(8), dp(8));
+        tv.setLayoutParams(lp);
+        return tv;
+    }
+
+    private View toolbar() {
+        LinearLayout bar = new LinearLayout(getContext());
+        bar.setOrientation(HORIZONTAL);
+        int k = q.netKind();
+        String glyph = k == 2 ? "📶" : (k == 1 ? "📱" : (k == 0 ? "📵" : "❓"));
+        bar.addView(logoButton(glyph, new Runnable() {
+            @Override public void run() {
+                speak("Сейчас: " + YtAudioQueue.netLabel(q.netKind()) + ". Загрузка: "
+                        + (q.autoMode() ? "автоматическая" : "ручная") + (q.wifiOnly() ? ", только по Вай-Фай" : ""));
+                rebuild();
+            }
+        }));
+        bar.addView(logoButton("📋", new Runnable() {
+            @Override public void run() { fromClipboard(); }
+        }));
+        bar.addView(logoButton("⬇", new Runnable() {
+            @Override public void run() { q.downloadAll(); }
+        }));
+        bar.addView(logoButton("🗑", new Runnable() {
+            @Override public void run() { confirmClear(); }
+        }));
+        return bar;
+    }
+
+    private void fromClipboard() {
+        try {
+            ClipboardManager cm = (ClipboardManager) getContext().getSystemService(Context.CLIPBOARD_SERVICE);
+            ClipData d = cm == null ? null : cm.getPrimaryClip();
+            CharSequence t = (d == null || d.getItemCount() == 0) ? null : d.getItemAt(0).getText();
+            String url = t == null ? "" : t.toString().trim();
+            String low = url.toLowerCase();
+            if (!low.startsWith("http") || !(low.contains("youtu.be/") || low.contains("youtube.com/"))) {
+                q.toast("В буфере нет ссылки на YouTube");
+                return;
+            }
+            q.submit(url, null);
+        } catch (Throwable e) {
+            q.toast("Не вышло: " + e);
+        }
+    }
+
+    private void confirmClear() {
+        try {
+            new AlertDialog.Builder(getContext(), android.R.style.Theme_DeviceDefault_Dialog_Alert)
+                    .setTitle("Очистить список?")
+                    .setPositiveButton("Очистить", new android.content.DialogInterface.OnClickListener() {
+                        @Override public void onClick(android.content.DialogInterface d, int w) { q.clear(); }
+                    })
+                    .setNegativeButton("Отмена", null)
+                    .show();
+        } catch (Throwable t) {
+            q.clear();
+        }
+    }
+
+    // ---------------------------------------------------------- плитка
+
+    /** Плитка 16:9: высота считается от ширины. */
+    private static final class Tile extends FrameLayout {
+        Tile(Context c) { super(c); }
+
+        @Override protected void onMeasure(int wSpec, int hSpec) {
+            int w = MeasureSpec.getSize(wSpec);
+            super.onMeasure(MeasureSpec.makeMeasureSpec(w, MeasureSpec.EXACTLY),
+                    MeasureSpec.makeMeasureSpec(w * 9 / 16, MeasureSpec.EXACTLY));
+        }
+    }
+
+    private TextView badge(String text) {
+        TextView b = new TextView(getContext());
+        b.setText(text);
+        b.setTextSize(16);
+        b.setTextColor(Color.WHITE);
+        b.setBackgroundColor(0xAA000000);
+        b.setGravity(Gravity.CENTER);
+        b.setPadding(dp(8), dp(4), dp(8), dp(4));
+        return b;
+    }
+
+    private View tile(final YtAudioQueue.Item it) {
+        Context ctx = getContext();
+        final String name = it.title.length() == 0 ? it.url : it.title;
+        final Tile tile = new Tile(ctx);
+        tile.setContentDescription(name);
+
+        ImageView img = new ImageView(ctx);
+        img.setScaleType(ImageView.ScaleType.CENTER_CROP);
+        img.setBackgroundColor(0xFFE0E0E0);
+        tile.addView(img, new FrameLayout.LayoutParams(-1, -1));
+
+        TextView ph = new TextView(ctx);
+        ph.setText(name);
+        ph.setTextSize(14);
+        ph.setTextColor(Color.BLACK);
+        ph.setGravity(Gravity.CENTER);
+        ph.setPadding(dp(10), dp(10), dp(10), dp(10));
+        ph.setMaxLines(4);
+        ph.setEllipsize(TextUtils.TruncateAt.END);
+        tile.addView(ph, new FrameLayout.LayoutParams(-1, -1));
+        loadThumb(it.url, img, ph);
+
+        final TextView over = badge(name);
+        over.setTextSize(15);
+        over.setBackgroundColor(0xCC000000);
+        over.setPadding(dp(10), dp(10), dp(10), dp(10));
+        over.setVisibility(GONE);
+        tile.addView(over, new FrameLayout.LayoutParams(-1, -1));
+
+        String mark = q.isActive(it.url) ? "⬇" : (YtAudioQueue.NO_TRACK.equals(it.status) ? "🚫"
+                : (YtAudioQueue.ERROR.equals(it.status) ? "⚠️" : "⏳"));
+        tile.addView(badge(mark), new FrameLayout.LayoutParams(-2, -2, Gravity.TOP | Gravity.START));
+
+        LinearLayout bar = new LinearLayout(ctx);
+        bar.setOrientation(HORIZONTAL);
+        TextView link = badge("🔗");
+        link.setOnClickListener(new OnClickListener() {
+            @Override public void onClick(View v) { openInBrowser(it.url); }
+        });
+        bar.addView(link);
+        TextView del = badge("🗑");
+        del.setOnClickListener(new OnClickListener() {
+            @Override public void onClick(View v) { q.remove(it.url); }
+        });
+        bar.addView(del);
+        tile.addView(bar, new FrameLayout.LayoutParams(-2, -2, Gravity.TOP | Gravity.END));
+
+        final Runnable hide = new Runnable() {
+            @Override public void run() { over.setVisibility(GONE); }
+        };
+        final GestureDetector gd = new GestureDetector(ctx, new GestureDetector.SimpleOnGestureListener() {
+            @Override public boolean onDown(MotionEvent e) { return true; }
+
+            @Override public boolean onSingleTapConfirmed(MotionEvent e) {
+                q.downloadOne(it);
+                return true;
+            }
+
+            @Override public boolean onDoubleTap(MotionEvent e) {
+                String st = YtAudioQueue.statusText(it);
+                over.setText(st.length() == 0 ? name : name + "\n" + st);
+                over.setVisibility(VISIBLE);
+                over.removeCallbacks(hide);
+                over.postDelayed(hide, 6000);
+                speak(st.length() == 0 ? name : name + ". " + st);
+                return true;
+            }
+        });
+        tile.setOnTouchListener(new OnTouchListener() {
+            @Override public boolean onTouch(View v, MotionEvent e) { return gd.onTouchEvent(e); }
+        });
+        return tile;
+    }
+
+    private void openInBrowser(String url) {
+        try {
+            Context c = getContext();
+            Intent i = new Intent(Intent.ACTION_VIEW, Uri.parse(url));
+            i.setClassName(c.getPackageName(), c.getPackageName() + ".BrowserApp");
+            i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            c.startActivity(i);
+        } catch (Throwable t) {
+            q.toast("Не открыть ссылку: " + t.getMessage());
+        }
+    }
+
+    // ---------------------------------------------------------- превью
+
+    private static String videoId(String url) {
+        Matcher m = ID.matcher(url);
+        return m.find() ? m.group(1) : null;
+    }
+
+    /** Превью из кэша или с i.ytimg.com (в фоне); без сети остаётся плитка с названием. */
+    private void loadThumb(String url, final ImageView iv, final View ph) {
+        final String id = videoId(url);
+        if (id == null) return;
+        iv.setTag(id);
+        final File f = new File(new File(getContext().getCacheDir(), "ytq"), id + ".jpg");
+        if (pool == null) pool = Executors.newFixedThreadPool(2);
+        pool.execute(new Runnable() {
+            @Override public void run() {
+                Bitmap bm = null;
+                try {
+                    if (!f.isFile()) {
+                        f.getParentFile().mkdirs();
+                        HttpURLConnection c = (HttpURLConnection) new URL("https://i.ytimg.com/vi/" + id + "/mqdefault.jpg").openConnection();
+                        c.setConnectTimeout(8000);
+                        c.setReadTimeout(8000);
+                        if (c.getResponseCode() == 200) {
+                            File tmp = new File(f.getPath() + ".tmp");
+                            InputStream in = c.getInputStream();
+                            OutputStream o = new FileOutputStream(tmp);
+                            try {
+                                byte[] buf = new byte[8192];
+                                int n;
+                                while ((n = in.read(buf)) > 0) o.write(buf, 0, n);
+                            } finally {
+                                o.close();
+                                in.close();
+                            }
+                            tmp.renameTo(f);
+                        }
+                    }
+                    if (f.isFile()) {
+                        BitmapFactory.Options o2 = new BitmapFactory.Options();
+                        o2.inPreferredConfig = Bitmap.Config.RGB_565;
+                        bm = BitmapFactory.decodeFile(f.getAbsolutePath(), o2);
+                    }
+                } catch (Throwable t) { }
+                final Bitmap fb = bm;
+                if (fb != null) {
+                    iv.post(new Runnable() {
+                        @Override public void run() {
+                            if (id.equals(iv.getTag())) {
+                                iv.setImageBitmap(fb);
+                                ph.setVisibility(GONE);
+                            }
+                        }
+                    });
+                }
+            }
+        });
+    }
+}
