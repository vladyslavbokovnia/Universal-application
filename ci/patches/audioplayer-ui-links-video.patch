+    private static String letters(String s) {
+        StringBuilder b = new StringBuilder();
+        String low = s.toLowerCase(Locale.ROOT);
+        for (int i = 0; i < low.length(); i++) if (Character.isLetterOrDigit(low.charAt(i))) b.append(low.charAt(i));
+        return b.toString();
+    }
+
+    /** Файл .url в той же папке с похожим именем (при сохранении имя могло чуть измениться); "" — нет. */
+    private static String similarLink(String path) {
+        try {
+            File f = new File(path);
+            File dir = f.getParentFile();
+            String name = f.getName();
+            int dot = name.lastIndexOf('.');
+            String want = letters(dot < 0 ? name : name.substring(0, dot));
+            File[] fs = dir == null ? null : dir.listFiles();
+            if (fs == null || want.length() < 6) return "";
+            for (File u : fs) {
+                String n = u.getName();
+                if (!n.toLowerCase(Locale.ROOT).endsWith(".url")) continue;
+                String have = letters(n.substring(0, n.length() - 4));
+                if (have.equals(want) || (have.length() >= 12 && (want.startsWith(have) || have.startsWith(want)))) {
+                    String r = readLinkFile(u.getPath().substring(0, u.getPath().length() - 4) + ".x");
+                    if (r.length() > 0) return r;
+                }
+            }
+        } catch (Throwable t) { }
+        return "";
+    }
