+        private final java.util.HashMap<Integer, String> profileUriCache = new java.util.HashMap<Integer, String>();
+        private final java.util.HashMap<Integer, Long> profileUriStamp = new java.util.HashMap<Integer, Long>();
+
+        /** Своя картинка профиля как data:-ссылка 96×96 для скриптов (кэшируется, пока файл не изменён); null, если картинки нет. */
+        private synchronized String profileImageUri(int idx) {
+            try {
+                Integer key = Integer.valueOf(idx);
+                File f = profileImageFile(idx);
+                if (!f.isFile()) { profileUriCache.remove(key); return null; }
+                long stamp = f.lastModified();
+                Long st = profileUriStamp.get(key);
+                String cached = profileUriCache.get(key);
+                if (cached != null && st != null && st.longValue() == stamp) return cached;
+                Bitmap b = loadBitmap(f);
+                if (b == null) return null;
+                int side = Math.min(b.getWidth(), b.getHeight());
+                Bitmap sq = Bitmap.createBitmap(b, (b.getWidth() - side) / 2, (b.getHeight() - side) / 2, side, side);
+                Bitmap small = Bitmap.createScaledBitmap(sq, 96, 96, true);
+                ByteArrayOutputStream bo = new ByteArrayOutputStream();
+                small.compress(Bitmap.CompressFormat.PNG, 100, bo);
+                String uri = "data:image/png;base64," + Base64.encodeToString(bo.toByteArray(), Base64.NO_WRAP);
+                profileUriCache.put(key, uri);
+                profileUriStamp.put(key, Long.valueOf(stamp));
+                return uri;
+            } catch (Throwable t) {
+                return null;
+            }
+        }
